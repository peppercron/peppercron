{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["family", "domDow", "dstGap", "dstOverlap"],
  "properties": {
    "family": { "$ref": "#/definitions/ids" },
    "domDow": { "$ref": "#/definitions/ids" },
    "dstGap": { "$ref": "#/definitions/ids" },
    "dstOverlap": { "$ref": "#/definitions/ids" }
  },
  "definitions": {
    "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z-]*$" } }
  }
}
