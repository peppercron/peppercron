{
  "id": "quartz",
  "family": "cron-fields",
  "fields": [
    { "name": "second", "min": 0, "max": 59 },
    { "name": "minute", "min": 0, "max": 59 },
    { "name": "hour", "min": 0, "max": 23 },
    { "name": "dayOfMonth", "min": 1, "max": 31, "tokens": ["?", "L", "L-n", "W", "LW"] },
    { "name": "month", "min": 1, "max": 12, "names": "month" },
    { "name": "dayOfWeek", "min": 1, "max": 7, "sundayIs": 1, "names": "dow", "tokens": ["?", "nL", "#"] },
    { "name": "year", "min": 1970, "max": 2099, "optional": true }
  ],
  "macros": {},
  "trailingCommand": false,
  "rangeWrap": "wrap",
  "singleStep": "to-max",
  "star": "leading",
  "domDow": "exclusive-question",
  "dstGap": "skip",
  "dstOverlap": "once-second",
  "missedRuns": "misfire-policy",
  "defaultTimezone": "host"
}
