{
  "id": "aws",
  "family": "cron-fields",
  "fields": [
    { "name": "minute", "min": 0, "max": 59 },
    { "name": "hour", "min": 0, "max": 23 },
    { "name": "dayOfMonth", "min": 1, "max": 31, "tokens": ["?", "L", "W"] },
    { "name": "month", "min": 1, "max": 12, "names": "month" },
    { "name": "dayOfWeek", "min": 1, "max": 7, "sundayIs": 1, "names": "dow", "tokens": ["?", "nL", "#"] },
    { "name": "year", "min": 1970, "max": 2199 }
  ],
  "macros": {},
  "trailingCommand": false,
  "wrapper": "cron",
  "rangeWrap": "wrap",
  "singleStep": "to-max",
  "star": "leading",
  "domDow": "exclusive-question",
  "dstGap": "skip",
  "dstOverlap": "once-first",
  "missedRuns": "flexible-window",
  "defaultTimezone": "utc"
}
