{
  "id": "github-actions",
  "family": "cron-fields",
  "fields": [
    { "name": "minute", "min": 0, "max": 59 },
    { "name": "hour", "min": 0, "max": 23 },
    { "name": "dayOfMonth", "min": 1, "max": 31 },
    { "name": "month", "min": 1, "max": 12, "names": "month" },
    { "name": "dayOfWeek", "min": 0, "max": 6, "sundayIs": 0, "names": "dow" }
  ],
  "macros": {},
  "trailingCommand": false,
  "wrapper": null,
  "interval": "none",
  "rangeWrap": "error",
  "singleStep": "to-max",
  "star": "leading",
  "domDow": "or",
  "dstGap": "next-valid",
  "dstOverlap": "vixie-window",
  "missedRuns": "best-effort",
  "defaultTimezone": "utc"
}
