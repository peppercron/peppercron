{
  "name": "peppercron",
  "version": "0.1.0",
  "description": "Parse cron schedules in five common dialects (vixie, Kubernetes, GitHub Actions, Quartz, AWS) and compute run times correctly across timezones and DST.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peppercron/peppercron.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/peppercron/peppercron#readme",
  "bugs": {
    "url": "https://github.com/peppercron/peppercron/issues"
  },
  "keywords": [
    "cron",
    "crontab",
    "cron-parser",
    "cron-expression",
    "schedule",
    "scheduler",
    "next-run",
    "timezone",
    "dst",
    "quartz",
    "kubernetes",
    "cronjob",
    "github-actions",
    "aws",
    "eventbridge"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen": "node scripts/gen-corpus.mjs",
    "pretest": "npm run gen",
    "test": "vitest run",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run gen",
    "build": "tsup",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run build && npm run size"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
